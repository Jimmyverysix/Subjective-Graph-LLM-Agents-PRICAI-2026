# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Environment / secrets
.env
.env.*

# Local LLM caches (do not upload)
cache/
cache_shared/

# Data (not included in repo)
data/*.csv

# -------------------------------------------------------------------
# Outputs:
# - 默认忽略所有 output 产物（尤其是超级大的 cache / json）
# - 但允许提交 `Proposal_2.tex` 里引用到的“论文必需小产物”（图表/表格）
# -------------------------------------------------------------------
output/**

# ---- keep: UAI figures referenced by Proposal_2.tex ----
!output/uai_figures/
!output/uai_figures/*.pdf
!output/uai_figures/*.png

!output/uai_figures_ci/
!output/uai_figures_ci/*.pdf
!output/uai_figures_ci/*.png

# ---- keep: degroot sweep figure referenced by Proposal_2.tex ----
!output/degroot_sweep/
!output/degroot_sweep/*.png

# ---- keep: single-run figures + LaTeX table referenced by Proposal_2.tex ----
!output/**/figures/
!output/**/figures/*.png
!output/**/figures/results_table.tex

# ---- still ignore: heavy artifacts inside output ----
output/**/cache/**
output/**/*.json
output/**/*.csv
output/**/*.parquet
output/**/*.pkl
output/**/*.pickle
output/**/*.npz
output/**/*.npy
output/**/*.pt
output/**/*.ckpt

# Temporary experiment folders
output/_tmp*/

